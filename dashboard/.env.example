# Copy to `.env` or `.env.local` and fill in real values. Do not commit secrets.

# Prisma / Vercel Postgres (set automatically when Storage is linked to the project)
# DATABASE_URL — pooled connection for the app (Prisma Client)
# POSTGRES_URL — direct connection for migrations (prisma db push)
DATABASE_URL=
POSTGRES_URL=

# Google OAuth (Web application client — not Android/iOS)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth — use a long random string in production (e.g. openssl rand -base64 32)
# Local dev only. On Vercel Production, set NEXTAUTH_URL=https://www.buddieai.com (code also pins this).
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
# Set to true on Vercel (also set automatically in production by lib/site-url.ts pinNextAuthUrl)
AUTH_TRUST_HOST=true
# Public canonical site (production: https://www.buddieai.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# App origin for embeds, widget API base, Lemon redirect URLs (production: https://www.buddieai.com)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Lemon Squeezy — Buddy AI is a premium product (no marketed free plan).
# Create Lemon products, then paste VARIANT IDs here / in Vercel. Do not invent IDs.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=
# Optional — auto-resolved from GET /v1/stores when unset (single-store accounts)
LEMONSQUEEZY_STORE_ID=
# REQUIRED: Starter $20/month checkout
LEMONSQUEEZY_STARTER_VARIANT_ID=
# REQUIRED: Pro $35/month checkout
LEMONSQUEEZY_PRO_VARIANT_ID=
# REQUIRED: Premium (higher tier; Agency-class until renamed) — either env works
LEMONSQUEEZY_PREMIUM_VARIANT_ID=
LEMONSQUEEZY_AGENCY_VARIANT_ID=
# Optional: Pro trial variant
LEMONSQUEEZY_PRO_TRIAL_VARIANT_ID=
# Optional: legacy enterprise variant (webhooks only)
LEMONSQUEEZY_ENTERPRISE_VARIANT_ID=

# Optional: full URL to livingface-widget.js on your CDN (no trailing slash)
WIDGET_CDN_URL=
# Optional: Chrome Web Store listing for "Add to Chrome" links
NEXT_PUBLIC_CHROME_EXTENSION_URL=https://chrome.google.com/webstore/detail/buddy-ai/PLACEHOLDER

# Optional admin-only outreach access (comma-separated emails)
BUDDY_ADMIN_EMAILS=

# Emotional Intelligence Data Layer — salt for irreversible session hashing (required in production)
EIDATA_HASH_SALT=

# Optional privacy-friendly analytics (Plausible/compatible script)
NEXT_PUBLIC_ANALYTICS_URL=
NEXT_PUBLIC_ANALYTICS_DOMAIN=

# Sentry monitoring
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# Optional: local-only auth config probe (/api/debug-auth). Never set in production.
# DEBUG_AUTH_SECRET=


# Web Push (Shadow Companion check-ins) — generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@buddieai.com
# Optional: protect /api/presence/push/send-checkin cron calls
CRON_SECRET=

# Living Buddy feature flags (optional — default on). Set to 0/false/off to disable.
NEXT_PUBLIC_FF_LIVING_BUDDY=1
NEXT_PUBLIC_FF_MOOD_UNIVERSE=1
NEXT_PUBLIC_FF_ORACLE_REALM=1
NEXT_PUBLIC_FF_BUDDY_EVOLUTION=1
NEXT_PUBLIC_FF_MEMORY_CONSTELLATION=1
NEXT_PUBLIC_FF_DAILY_RITUAL=1
NEXT_PUBLIC_FF_VIBE_PROFILE=1
NEXT_PUBLIC_FF_ORB_EVOLUTION=1
NEXT_PUBLIC_FF_BUDDY_MOMENTS=1
NEXT_PUBLIC_FF_SHARE_CARDS=1

# Optional aliases only — primary checkout vars are STARTER / PRO / PREMIUM above.
# Do not invent variant IDs; create Lemon products first.

