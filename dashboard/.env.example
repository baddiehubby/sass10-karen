# Copy to `.env` or `.env.local` and fill in real values. Do not commit secrets.

# Prisma (SQLite example for local dev)
DATABASE_URL="file:./dev.db"

# NextAuth — use a long random string in production (e.g. openssl rand -base64 32)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Lemon Squeezy (active payment provider)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_PRO_VARIANT_ID=
LEMONSQUEEZY_AGENCY_VARIANT_ID=

# Optional: full URL to livingface-widget.js on your CDN (no trailing slash)
WIDGET_CDN_URL=

# Optional admin-only outreach access (comma-separated emails)
BUDDY_ADMIN_EMAILS=

# Optional privacy-friendly analytics (Plausible/compatible script)
NEXT_PUBLIC_ANALYTICS_URL=
NEXT_PUBLIC_ANALYTICS_DOMAIN=

# Sentry monitoring
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# Optional: set to 1 only if you intentionally want /api/dev/widget outside development
ALLOW_WIDGET_PROXY=
