# BuddieAI environment template — names only. Never put real secrets here.
# Copy to `.env.local` for local development. Set real values in Vercel for production.

# =============================================================================
# REQUIRED — production
# =============================================================================
DATABASE_URL=YOUR_VALUE_HERE
NEXTAUTH_SECRET=YOUR_VALUE_HERE
NEXTAUTH_URL=https://www.buddieai.com
NEXT_PUBLIC_SITE_URL=https://www.buddieai.com
NEXT_PUBLIC_APP_URL=https://www.buddieai.com
# -----------------------------------------------------------------------------
# Lemon Squeezy (Buddy billing + Karen VIP)
# -----------------------------------------------------------------------------
# API + store (checkout creation)
LEMONSQUEEZY_API_KEY=YOUR_VALUE_HERE
LEMONSQUEEZY_STORE_ID=YOUR_VALUE_HERE
# Webhook HMAC — Buddy: POST /api/lemonsqueezy/webhook
#                Karen: POST /api/webhooks/lemonsqueezy
LEMONSQUEEZY_WEBHOOK_SECRET=YOUR_VALUE_HERE
# Buddy plan variant IDs
LEMONSQUEEZY_STARTER_VARIANT_ID=YOUR_VALUE_HERE
LEMONSQUEEZY_PRO_VARIANT_ID=YOUR_VALUE_HERE
LEMONSQUEEZY_PREMIUM_VARIANT_ID=YOUR_VALUE_HERE
# Karen VIP ($19/mo) — checkout server action + /api/webhooks/lemonsqueezy
LEMONSQUEEZY_KAREN_VIP_VARIANT_ID=YOUR_VALUE_HERE
EIDATA_HASH_SALT=YOUR_VALUE_HERE

# =============================================================================
# REQUIRED — when Google OAuth is enabled (both or neither)
# =============================================================================
GOOGLE_CLIENT_ID=YOUR_VALUE_HERE
GOOGLE_CLIENT_SECRET=YOUR_VALUE_HERE

# -----------------------------------------------------------------------------
# Karen TTS (TalkingHead lip-sync via /api/karen/tts → speakAudio)
# Prefer OpenAI; Google Cloud TTS is a second option. Without either, a
# translate.google.com fallback may be used for local/dev (disable with =0).
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=YOUR_VALUE_HERE
# KAREN_TTS_API_KEY=YOUR_VALUE_HERE
# KAREN_TTS_MODEL=tts-1
# KAREN_TTS_VOICE=nova
# GOOGLE_TTS_API_KEY=YOUR_VALUE_HERE
# KAREN_TTS_GOOGLE_VOICE=en-US-Neural2-F
# KAREN_TTS_LANG=en-US
# KAREN_TTS_ALLOW_TRANSLATE_FALLBACK=1

# =============================================================================
# OPTIONAL — production
# =============================================================================
POSTGRES_URL=YOUR_VALUE_HERE
LEMONSQUEEZY_AGENCY_VARIANT_ID=YOUR_VALUE_HERE
LEMONSQUEEZY_PRO_TRIAL_VARIANT_ID=YOUR_VALUE_HERE
LEMONSQUEEZY_ENTERPRISE_VARIANT_ID=YOUR_VALUE_HERE
# Capacitor Android WebView target (optional; defaults to NEXT_PUBLIC_APP_URL)
# CAPACITOR_SERVER_URL=https://www.buddieai.com
WIDGET_CDN_URL=YOUR_VALUE_HERE
NEXT_PUBLIC_CHROME_EXTENSION_URL=https://chrome.webstore.google.com/detail/buddy-ai/PLACEHOLDER
BUDDY_ADMIN_EMAILS=YOUR_VALUE_HERE
NEXT_PUBLIC_ANALYTICS_URL=YOUR_VALUE_HERE
NEXT_PUBLIC_ANALYTICS_DOMAIN=YOUR_VALUE_HERE
SENTRY_DSN=YOUR_VALUE_HERE
NEXT_PUBLIC_SENTRY_DSN=YOUR_VALUE_HERE
SENTRY_ORG=YOUR_VALUE_HERE
SENTRY_PROJECT=YOUR_VALUE_HERE
VAPID_PUBLIC_KEY=YOUR_VALUE_HERE
VAPID_PRIVATE_KEY=YOUR_VALUE_HERE
VAPID_SUBJECT=mailto:support@buddieai.com
CRON_SECRET=YOUR_VALUE_HERE
AUTH_TRUST_HOST=true

# =============================================================================
# LOCAL DEVELOPMENT ONLY
# =============================================================================
# NEXTAUTH_URL=http://localhost:3000
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# DEBUG_AUTH_SECRET=YOUR_VALUE_HERE
# ALLOW_WIDGET_PROXY=0
# BUDDIE_USER_AUTHORIZED_INTELLIGENCE=0
# BUDDIE_INTERNAL_TELEMETRY_SECRET=YOUR_VALUE_HERE
# Ollama (Karen chat — local only)
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2

# =============================================================================
# FEATURE FLAGS (optional — default on)
# =============================================================================
NEXT_PUBLIC_FF_LIVING_BUDDY=1
NEXT_PUBLIC_FF_MOOD_UNIVERSE=1
NEXT_PUBLIC_FF_ORACLE_REALM=1
NEXT_PUBLIC_FF_BUDDY_EVOLUTION=1
NEXT_PUBLIC_FF_MEMORY_CONSTELLATION=1
NEXT_PUBLIC_FF_DAILY_RITUAL=1
NEXT_PUBLIC_FF_VIBE_PROFILE=1
NEXT_PUBLIC_FF_ORB_EVOLUTION=1
NEXT_PUBLIC_FF_BUDDY_MOMENTS=1
NEXT_PUBLIC_FF_SHARE_CARDS=1
