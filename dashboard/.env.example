# Copy to `.env` or `.env.local` and fill in real values. Do not commit secrets.

# Prisma / Vercel Postgres (set automatically when Storage is linked to the project)
# DATABASE_URL — pooled connection for the app (Prisma Client)
# POSTGRES_URL — direct connection for migrations (prisma db push)
DATABASE_URL=
POSTGRES_URL=

# Google OAuth (Web application client — not Android/iOS)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth — use a long random string in production (e.g. openssl rand -base64 32)
# Local dev only. On Vercel Production, set NEXTAUTH_URL=https://www.buddieai.com (code also pins this).
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
# Set to true on Vercel (also set automatically in production by lib/site-url.ts pinNextAuthUrl)
AUTH_TRUST_HOST=true
# Public canonical site (production: https://www.buddieai.com) — used for client sign-in callbackUrl
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Lemon Squeezy — paid checkout only (Buddy Free is in-app, no Lemon product)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=
# Optional — auto-resolved from GET /v1/stores when unset (single-store accounts)
LEMONSQUEEZY_STORE_ID=
# Required for /pricing Pro checkout ($29.99 product in Lemon)
LEMONSQUEEZY_PRO_VARIANT_ID=
# Required for /pricing Agency checkout ($199.99 product in Lemon)
LEMONSQUEEZY_AGENCY_VARIANT_ID=
# Optional: legacy Lemon "Starter" variant — webhooks map to Pro in-app
LEMONSQUEEZY_STARTER_VARIANT_ID=
# Optional: Pro trial variant
LEMONSQUEEZY_PRO_TRIAL_VARIANT_ID=
# Optional: legacy enterprise variant (webhooks only)
LEMONSQUEEZY_ENTERPRISE_VARIANT_ID=

# Optional: full URL to livingface-widget.js on your CDN (no trailing slash)
WIDGET_CDN_URL=
# Optional: Chrome Web Store listing for "Add to Chrome" links
NEXT_PUBLIC_CHROME_EXTENSION_URL=

# Optional admin-only outreach access (comma-separated emails)
BUDDY_ADMIN_EMAILS=

# Optional privacy-friendly analytics (Plausible/compatible script)
NEXT_PUBLIC_ANALYTICS_URL=
NEXT_PUBLIC_ANALYTICS_DOMAIN=

# Sentry monitoring
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# Optional: set to 1 only if you intentionally want /api/dev/widget outside development
ALLOW_WIDGET_PROXY=
