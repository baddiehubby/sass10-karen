# Copy to `.env` or `.env.local` and fill in real values. Do not commit secrets.

# Prisma / Vercel Postgres (set automatically when Storage is linked to the project)
# DATABASE_URL — pooled connection for the app (Prisma Client)
# POSTGRES_URL — direct connection for migrations (prisma db push)
DATABASE_URL=
POSTGRES_URL=

# NextAuth — use a long random string in production (e.g. openssl rand -base64 32)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Lemon Squeezy (active payment provider)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_STARTER_VARIANT_ID=
# Optional: separate Lemon variant with 14-day trial (falls back to STARTER_VARIANT_ID)
LEMONSQUEEZY_STARTER_TRIAL_VARIANT_ID=
LEMONSQUEEZY_AGENCY_VARIANT_ID=
LEMONSQUEEZY_ENTERPRISE_VARIANT_ID=
# Legacy alias for Starter (optional)
LEMONSQUEEZY_PRO_VARIANT_ID=

# Optional: full URL to livingface-widget.js on your CDN (no trailing slash)
WIDGET_CDN_URL=
# Optional: Chrome Web Store listing for "Add to Chrome" links
NEXT_PUBLIC_CHROME_EXTENSION_URL=

# Optional admin-only outreach access (comma-separated emails)
BUDDY_ADMIN_EMAILS=

# Optional privacy-friendly analytics (Plausible/compatible script)
NEXT_PUBLIC_ANALYTICS_URL=
NEXT_PUBLIC_ANALYTICS_DOMAIN=

# Sentry monitoring
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# Optional: set to 1 only if you intentionally want /api/dev/widget outside development
ALLOW_WIDGET_PROXY=
