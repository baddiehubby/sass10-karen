# =============================================================================
# KAREN + Buddie — Vercel Production Environment Variables
# =============================================================================
# Copy these into Vercel → Project → Settings → Environment Variables
# (Environment: Production). NEVER commit real secrets.
#
# This file is a TEMPLATE only (placeholders). Real values go in the Vercel UI
# or a local gitignored `.env.production` for CLI deploys.
# =============================================================================

# -----------------------------------------------------------------------------
# Core (REQUIRED)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=https://www.buddieai.com
NEXT_PUBLIC_SITE_URL=https://www.buddieai.com
NEXT_PUBLIC_APP_URL=https://www.buddieai.com
# Capacitor / mobile — absolute API origin for Karen fetches
NEXT_PUBLIC_API_URL=https://www.buddieai.com
# Capacitor WebView target (defaults to NEXT_PUBLIC_APP_URL)
CAPACITOR_SERVER_URL=https://www.buddieai.com
AUTH_TRUST_HOST=true
EIDATA_HASH_SALT=long-random-salt-different-from-nextauth

# -----------------------------------------------------------------------------
# Lemon Squeezy — Buddy billing + Karen VIP (REQUIRED for payments)
# -----------------------------------------------------------------------------
LEMONSQUEEZY_API_KEY=your_lemon_api_key
LEMONSQUEEZY_STORE_ID=your_store_id
LEMONSQUEEZY_WEBHOOK_SECRET=your_webhook_signing_secret

# Buddy plan variants
LEMONSQUEEZY_STARTER_VARIANT_ID=
LEMONSQUEEZY_PRO_VARIANT_ID=
LEMONSQUEEZY_PREMIUM_VARIANT_ID=

# Karen VIP ($19/mo) — used by createKarenVipCheckout + /api/webhooks/lemonsqueezy
LEMONSQUEEZY_KAREN_VIP_VARIANT_ID=your_karen_vip_variant_id

# -----------------------------------------------------------------------------
# ElevenLabs — Karen premium TTS via /api/tts (REQUIRED for realistic voice)
# -----------------------------------------------------------------------------
ELEVENLABS_API_KEY=your_elevenlabs_api_key
# Optional overrides (defaults: Matilda + multilingual v2)
# ELEVENLABS_VOICE_ID=XrExE9yKIg1WjnnlVkGX
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# -----------------------------------------------------------------------------
# Google OAuth (REQUIRED if Google sign-in is enabled)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Optional — production
# -----------------------------------------------------------------------------
# POSTGRES_URL=  # only if something else reads this alias; Prisma uses DATABASE_URL
# LEMONSQUEEZY_AGENCY_VARIANT_ID=
# LEMONSQUEEZY_PRO_TRIAL_VARIANT_ID=
# LEMONSQUEEZY_ENTERPRISE_VARIANT_ID=
# CAPACITOR_SERVER_URL=https://www.buddieai.com
# WIDGET_CDN_URL=
# BUDDY_ADMIN_EMAILS=you@buddieai.com
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# CRON_SECRET=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@buddieai.com

# -----------------------------------------------------------------------------
# Lemon webhook URLs to register in Lemon Squeezy dashboard
# -----------------------------------------------------------------------------
# Karen VIP:  https://www.buddieai.com/api/webhooks/lemonsqueezy
#   Events: subscription_created, subscription_cancelled, subscription_expired,
#           subscription_payment_success, subscription_resumed, subscription_updated
# Buddy:      https://www.buddieai.com/api/lemonsqueezy/webhook
#   (existing Buddy entitlement pipeline — keep both if Buddy + Karen share a store)
