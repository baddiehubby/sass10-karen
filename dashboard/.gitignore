# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# env files (secrets — never commit). `.env.example` is tracked on purpose.
.env
.env.local
.env.development
.env.production
.env*.local
.env*
!.env.example
!.env.production.example

# secrets & credentials
*.pem
*.p12
*.pfx
*.key
*credentials*.json
*serviceAccount*.json
*service-account*.json
*.keystore
id_rsa
id_rsa.pub
secrets/
.secrets/
.env*.bak
*.env.bak

# vercel
.vercel

# typescript
*.tsbuildinfo

# widget bundle intermediate output + generated static copy (keep public/widget/.gitkeep tracked)
/widget-lib/dist
/public/widget/livingface-widget.js
dashboard/public/widget/livingface-widget.js

# prisma local database (never commit — may contain user PII)
/prisma/dev.db
/prisma/dev.db-journal
/prisma/**/*.db
/prisma/**/*.db-journal
*.db
*.db-journal
*.sqlite
*.sqlite3

# Python TTS venvs / caches (Kokoro, Maya1)
/scripts/kokoro_venv/
/scripts/maya_tts/
**/__pycache__/
*.pyc

# OS / IDE / temp
.DS_Store
Thumbs.db
.idea/
*.swp
*~
tmp/
temp/
*.tmp
*.log
logs/

# uploaded license orb assets (keep folder via .gitkeep)
/public/license-themes/*
!/public/license-themes/.gitkeep

.vercel
.env*.local
