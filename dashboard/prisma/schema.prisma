generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String
  name      String?
  companyName String?
  companionName String?
  personality   String?
  onboardingCompleted Boolean @default(false)
  /// User completed the EIData consent modal (Accept or Decline).
  eidataConsentCompleted Boolean @default(false)
  /// Optional external customer identifier for migration compatibility.
  stripeCustomerId String? @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  licenses  License[]
  payments  PendingPayment[]
  badges    UserBadge[]
  emails    WelcomeEmail[]
  sentEmails SentEmail[]
  consents  UserConsent[]
  buddyBond BuddyBond?
  subscriptions Subscription[]
  mobileDevices            MobileDevice[]
  mobileAuthorizationCodes MobileAuthorizationCode[]
  mobileRefreshTokens      MobileRefreshToken[]
}

model License {
  id          String   @id @default(cuid())
  key         String   @unique
  userId      String
  features    String
  domain      String?
  plan        String   @default("free")
  /// HMAC widget/analytics session token (indexed lookup — never full-table scan).
  widgetSessionToken String? @unique
  expiresAt   DateTime
  activatedAt DateTime?
  widgetTooltipText String?
  widgetPosition    String   @default("bottom-right")
  widgetSize        String   @default("medium")
  widgetZIndex      Int?
  widgetCustomCss   String?
  widgetThemeMode   String   @default("auto")
  forcedMood        String?
  forcedMoodUntil   DateTime?
  /// Optional payment order identifier kept for backward compatibility.
  paidOrderId       String?  @unique
  /// Optional checkout session identifier kept for backward compatibility.
  stripeCheckoutSessionId String? @unique
  lemonSqueezyId String? @unique
  lemonSqueezySubscriptionId String? @unique
  lemonSqueezyVariantId String?
  lemonSqueezySubscriptionStatus String?
  lemonSqueezyCustomerPortalUrl String?
  /// Optional hex overrides for preset orb gradient (#RRGGBB).
  themeAccentHex    String?
  themeDeepHex      String?
  /// Public URL path or absolute URL for custom orb background (PNG/SVG)
  themeImageUrl String?
  /// Preset id: default | ocean | sunset | neon | forest
  themePreset   String   @default("default")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  moodEvents  MoodEvent[]
  complianceReports ComplianceReport[]
  lemonWebhookEvents LemonSqueezyWebhookEvent[]
  collaborativeRoom CollaborativeRoom?
  presence      CompanionPresence?
  pushSubscriptions PushSubscription[]
  mobileAuthorizationCodes MobileAuthorizationCode[]
  mobileRefreshTokens      MobileRefreshToken[]
}

/// Cross-device Shadow Companion mood state (license-key anchor).
model CompanionPresence {
  id            String   @id @default(cuid())
  licenseId     String   @unique
  currentMood   String   @default("neutral")
  moodHistory   String   @default("[]")
  lastCheckIn   DateTime @default(now())
  guidanceQueue String   @default("[]")
  companionName String   @default("Buddy")
  updatedAt     DateTime @updatedAt

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)
}

/// Web Push subscription for ambient check-ins (VAPID).
model PushSubscription {
  id           String   @id @default(cuid())
  licenseId    String
  endpoint     String   @unique
  p256dh       String
  auth         String
  createdAt    DateTime @default(now())

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([licenseId])
}

model LemonSqueezyWebhookEvent {
  id          String   @id @default(cuid())
  eventName   String
  lemonEventId String?
  licenseId   String?
  subscriptionId String?
  payload     String
  receivedAt  DateTime @default(now())

  license License? @relation(fields: [licenseId], references: [id], onDelete: SetNull)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([licenseId, receivedAt])
  @@index([subscriptionId, receivedAt])
  @@index([eventName, receivedAt])
  @@unique([lemonEventId])
}

/// Normalized provider subscription — server source of truth for billing state.
model Subscription {
  id                     String    @id @default(cuid())
  userId                 String
  provider               String    @default("lemonsqueezy")
  providerCustomerId     String?
  providerSubscriptionId String    @unique
  variantId              String?
  /// App plan: starter | pro | premium | agency | free
  plan                   String    @default("free")
  status                 String
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelledAt            DateTime?
  customerPortalUrl      String?
  /// Lemon attributes.updated_at — used to ignore stale out-of-order webhooks.
  providerUpdatedAt      DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  webhookEvents          LemonSqueezyWebhookEvent[]

  @@index([userId, status])
  @@index([provider, status])
}

model PendingPayment {
  id        String   @id @default(cuid())
  orderId   String   @unique
  userId    String
  plan      String
  amountUsd Int
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Granular GDPR / EU AI Act / SB 243 consent records per user and purpose.
model UserConsent {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose     String   // companion_mood_detection | anonymous_analytics | model_training | data_selling
  status      String   // granted | denied | withdrawn
  consentedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, purpose])
  @@index([userId, status])
}

/// Product-improvement layer — mood labels only, irreversible session hash, no raw text.
model AnonymizedMoodEvent {
  id            String   @id @default(cuid())
  sessionToken  String   // SHA-256(salt + pseudonymous session id), not reversible to user
  mood          String
  timestamp     DateTime @default(now())
  region        String?  // broad bucket: EU | US | Asia | Other
  companionType String?  // buddy | sachapandit
  source        String?  // chatgpt | claude | gemini | website | extension | unknown

  @@index([timestamp])
  @@index([mood, timestamp])
  @@index([sessionToken, timestamp])
}

/// Anonymous widget mood telemetry (license-holder dashboard — requires companion_mood_detection consent).
model MoodEvent {
  id         String   @id @default(cuid())
  licenseId  String
  mood       String
  domain     String?
  /// Deprecated — never populated (raw conversation text prohibited).
  messageSnippet String?
  timestamp  DateTime
  acknowledgedBy String?
  acknowledgedAt DateTime?
  license    License  @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([licenseId, timestamp])
  @@index([licenseId, mood, acknowledgedAt, timestamp])
}

model ComplianceReport {
  id          String   @id @default(cuid())
  licenseId   String
  generatedAt DateTime @default(now())
  data        String

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([licenseId, generatedAt])
}

model CollaborativeRoom {
  id        String   @id @default(cuid())
  licenseId String   @unique
  mood      String   @default("neutral")
  updatedAt DateTime @updatedAt

  license   License  @relation(fields: [licenseId], references: [id], onDelete: Cascade)
}

model Badge {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  icon        String
  condition   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  awardedAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

model WelcomeEmail {
  id        String   @id @default(cuid())
  userId    String
  subject   String
  body      String
  sentAt    DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Demo outreach emails queued from the dashboard (swap provider in lib/outreach-send.ts).
model SentEmail {
  id              String   @id @default(cuid())
  userId          String
  recipientEmail  String
  subject         String
  body            String
  sentAt          DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sentAt])
}

/// Buddy Soul Engine — persistent companion identity. Internal bondDepth is never shown as a score.
model BuddyBond {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Internal only. Never displayed as a number.
  bondDepth      Int      @default(0)
  buddyMood      String   @default("curious")
  buddyEnergy    Float    @default(0.5)
  evolutionStage String   @default("awakening")
  humorTone      Float    @default(0.0)
  mysticismTone  Float    @default(0.0)
  warmthTone     Float    @default(0.5)
  lastPresence   DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  memories      MemoryFragment[]
  unlockedAuras UnlockedAura[]
  rituals       DailyRitual[]
}

/// Poetic moment between user and Buddy. Not a clinical log.
model MemoryFragment {
  id           String    @id @default(cuid())
  userId       String
  bond         BuddyBond @relation(fields: [userId], references: [userId], onDelete: Cascade)
  bornFromMood String
  verse        String
  orbEcho      String    @default("held a quiet light")
  hidden       Boolean   @default(true)
  discoveredAt DateTime?
  weight       Float     @default(0.5)
  createdAt    DateTime  @default(now())

  @@index([userId, hidden])
}

/// Visual manifestations of the Bond.
model UnlockedAura {
  id          String   @id @default(cuid())
  userId      String
  bond        BuddyBond @relation(fields: [userId], references: [userId], onDelete: Cascade)
  auraId      String
  displayName String
  rarity      String   @default("common")
  origin      String
  active      Boolean  @default(false)
  unlockedAt  DateTime @default(now())

  @@unique([userId, auraId])
}

/// Daily rituals. ritualDate is a calendar date so uniqueness is per day, not per timestamp.
model DailyRitual {
  id           String    @id @default(cuid())
  userId       String
  bond         BuddyBond @relation(fields: [userId], references: [userId], onDelete: Cascade)
  ritualDate   DateTime  @db.Date
  ritualType   String
  completed    Boolean   @default(false)
  completedAt  DateTime?
  buddyWhisper String?

  @@unique([userId, ritualDate, ritualType])
  @@index([userId, ritualDate])
}

/// Registered native signing key; no invasive hardware identifier is stored.
model MobileDevice {
  id            String    @id @default(cuid())
  userId        String
  keyThumbprint String    @unique
  publicKeySpki String
  platform      String?
  displayName   String?
  appVersion    String?
  revokedAt     DateTime?
  lastSeenAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user               User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  authorizationCodes MobileAuthorizationCode[]
  refreshTokens      MobileRefreshToken[]
  proofNonces        MobileProofNonce[]

  @@index([userId, revokedAt])
}

/// Hash-addressed, short-lived JWE handoff consumed exactly once.
model MobileAuthorizationCode {
  id         String    @id @default(cuid())
  jti        String    @unique
  codeHash   String    @unique
  userId     String
  licenseId  String
  deviceId   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  license License      @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  device  MobileDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, expiresAt])
  @@index([userId, consumedAt])
}

/// Only the SHA-256 hash of the encrypted refresh credential is retained.
model MobileRefreshToken {
  id                String    @id @default(cuid())
  jti               String    @unique
  tokenHash         String    @unique
  familyId          String
  userId            String
  licenseId         String
  deviceId          String
  credentialVersion String
  expiresAt         DateTime
  lastUsedAt        DateTime?
  rotatedAt         DateTime?
  replacedByTokenId String?   @unique
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())

  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  license    License              @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  device     MobileDevice         @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  replacedBy MobileRefreshToken?  @relation("MobileRefreshRotation", fields: [replacedByTokenId], references: [id], onDelete: SetNull)
  replaces   MobileRefreshToken[] @relation("MobileRefreshRotation")

  @@index([familyId, revokedAt])
  @@index([deviceId, revokedAt])
  @@index([userId, revokedAt])
}

/// A signed proof nonce is unique for its device and operation purpose.
model MobileProofNonce {
  id         String   @id @default(cuid())
  deviceId   String
  purpose    String
  nonceHash  String
  proofTime  DateTime
  expiresAt  DateTime
  consumedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  device MobileDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, purpose, nonceHash])
  @@index([expiresAt])
}
